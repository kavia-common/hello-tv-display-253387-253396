<?xml version="1.0" encoding="utf-8"?>
<!--
    Simple TV splash: centered Hello TV with accent underline, minimal and theme colors.
    Not directly used, but provided for IDE preview/future possible extension.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="48dp">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello TV"
            android:textColor="#111827"
            android:textSize="48sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <View
            android:id="@+id/accent_underline"
            android:layout_width="72dp"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:background="#F59E0B"/>

    </LinearLayout>
</FrameLayout>
